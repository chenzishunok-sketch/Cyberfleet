# Server
PORT=8795
KOL_BRIDGE_PORT=8796
DEMO_MODE=true

# 访问口令门（可选）：填写后整站需要先登录才能访问，保护店铺数据与写操作权限。
# 留空则不做鉴权——仅在本地单机使用时可留空，公网部署务必设置。
APP_PASSWORD=
# 会话签名密钥，留空则由 APP_PASSWORD 派生（改口令即让所有旧会话失效）
SESSION_SECRET=
# 会话有效期（秒），默认 12 小时
AUTH_SESSION_TTL=43200
# OAuth 授权完成后跳回前端的地址（必须与 Vite 端口一致，且在 ALLOWED_FRONTEND_ORIGINS 白名单内）
FRONTEND_URL=http://localhost:5182
ALLOWED_FRONTEND_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
WORKFLOW_DATABASE=.data/workflows.sqlite
ACTION_PLAN_DATABASE=.data/workflows.sqlite
INTELLIGENCE_DATABASE=.data/workflows.sqlite
AGENT_MEMORY_PATH=.data/memory.json

# Any OpenAI-compatible chat completion endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional smaller model for routing, memory extraction and concise web summaries
LLM_FAST_MODEL=

# 百度搭子（DuMate）对话接入（可选）
# 开启后：普通聊天/知识问答/运营建议由搭子接管（前端 UI 不变，SSE 协议不变）；
# 经营数据查询与写操作仍走上方 LLM + 工具链路，审批卡机制不受影响。
# Agent 需先在百度搭子管理平台创建，API Key 在平台「API 集成」中创建。
DUMATE_ENABLED=false
DUMATE_BASE_URL=https://api.dumate.cn
DUMATE_API_KEY=
DUMATE_AGENT_ID=
# 单轮对话最长等待秒数（默认 90）
DUMATE_TIMEOUT_SECONDS=90

# Agent web search (Tavily, server-side only)
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

# Agnes multimodal content generation (server-side only)
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_API_KEY=
# Optional public temporary upload endpoint used by image-to-video
CONTENT_PUBLIC_UPLOAD_URL=https://tmpfiles.org/api/v1/upload

# TikTok Shop connector (server-side only)
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_SERVICE_ID=7660083559697663764
TIKTOK_SHOP_AUTH_URL=https://services.tiktokshop.com/open/authorize?service_id=7660083559697663764
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_SHOP_CIPHER=

# Miaoshou ERP connector (1688 collection & listing)
MIAOSHOU_BASE_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=

# TMAPI 1688 product data (server-side only)
TMAPI_BASE_URL=http://api.tmapi.top
# 可选：自定义本地图片临时上传地址；未配置时会自动使用内置图片通道和备用通道
SOURCING_IMAGE_UPLOAD_URL=
TMAPI_API_TOKEN=

# Chuhaijiang (出海匠) TikTok 美区选品数据 MCP (server-side only)
CHUHAIJIANG_MCP_URL=https://mcp.gateway.chuhaijiang.com/mcp
CHUHAIJIANG_API_KEY=

# Feishu connector (server-side only)
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=
FEISHU_APP_SECRET=
